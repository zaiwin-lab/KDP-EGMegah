# ─────────────────────────────────────────────────────────────────────────
# Land2Home Concierge — environment variables
#
# Copy to .env and fill in. With none of these set the portal runs on its
# built-in demonstration data, which is how it starts out of the box.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is public.
# Never put a secret behind a VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (optional) ──────────────────────────────────────────────────
# Set BOTH to switch the portal from demonstration data to a real database.
# The anon key is safe in the browser: it grants nothing on its own, because
# every table is protected by the row-level security policies in
# supabase/schema.sql. Apply that file before pointing the app at a project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER add the Supabase service_role key here, or anywhere with a VITE_
# prefix. It bypasses row-level security. If a server-side job needs it,
# set SUPABASE_SERVICE_ROLE_KEY in the Netlify function environment only.

# ── Assisted document reading and plain-language drafting (optional) ──────
# Server-side only, read by netlify/functions/. Without it the portal falls
# back to its built-in offline engine and everything still works.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Branding (optional) ──────────────────────────────────────────────────
# Lets the same platform be deployed for another cooperative and builder.
VITE_PORTAL_NAME=Land2Home Concierge
